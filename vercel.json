{
  "version": 2,
  "builds": [
    {
      "src": "pubspec.yaml",
      "use": "@vercel/flutter",
      "env": {
        "SUPABASE_URL": "@SUPABASE_URL",
        "SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "build": {
    "env": {
      "SUPABASE_URL": "@SUPABASE_URL",
      "SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY"
    }
  }
}
